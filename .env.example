# Copy this file to .env and fill in values for your local setup.
# .env is gitignored and must never be committed.

# --- Local Postgres (docker-compose) ---
# docker-compose.yml runs Postgres with POSTGRES_HOST_AUTH_METHOD: trust,
# so DB_PASSWORD can be left empty for local dev.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=notes

# --- Cloud SQL (production / Cloud Run only) ---
# When set, the app connects via the Cloud SQL Auth Proxy unix socket
# instead of DB_HOST/DB_PORT. Leave unset for local dev.
# Format: PROJECT_ID:REGION:INSTANCE_NAME
INSTANCE_CONNECTION_NAME=

# --- Google Cloud Storage ---
# Bucket used to store uploaded note photos. Leave unset to disable photo uploads locally.
BUCKET_NAME=

# --- Server ---
PORT=3000
